    plot(t,clean)
    hold on
    plot(t,noisy)
    xlim([0 0.5])
    grid on

    xlabel('Time (s)')
    ylabel('Amplitude')
    title(sprintf('Time Domain, SNR = %d dB',snr_db))
    legend('Clean','Noisy')

    subplot(2,1,2)
    plot(f,magClean)
    hold on
    plot(f,magNoisy)
    xlim([0 100])
    grid on

    xlabel('Frequency (Hz)')
    ylabel('Magnitude')
    title(sprintf('Frequency Domain, SNR = %d dB',snr_db))
    legend('Clean','Noisy')
end

