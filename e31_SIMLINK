rng(1)                 % Repeatable noise

fs = 1000;
t = 0:1/fs:2-1/fs;

f0 = 10;
clean = sin(2*pi*f0*t);

Psignal = mean(clean.^2);

snr_values = [20 10 0];

for k = 1:length(snr_values)

    snr_db = snr_values(k);

    Pnoise = Psignal / 10^(snr_db/10);
    sigma = sqrt(Pnoise);

    noise = sigma*randn(size(clean));
    noisy = clean + noise;

    % FFTs
    N = length(clean);

    Yclean = fft(clean);
    Ynoisy = fft(noisy);

    f = (0:floor(N/2))*fs/N;

    magClean = abs(Yclean(1:floor(N/2)+1))*2/N;
    magNoisy = abs(Ynoisy(1:floor(N/2)+1))*2/N;

    figure

