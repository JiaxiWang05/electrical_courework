    N = length(xFFT);
    Y = fft(xFFT);

    f = (0:floor(N/2))*fs/N;
    mag = abs(Y(1:floor(N/2)+1));

    % Ignore DC
    [~,idx] = max(mag(2:end));
    idx = idx + 1;

    measured_alias(k) = f(idx);
end

